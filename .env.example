# Copy this file to .env and fill in the values. Never commit .env.
# Secrets marked (secret) must never be shared, logged or pasted anywhere.

# ── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=8787
# The website address. Only this site may call sign-in endpoints (CSRF protection).
WEB_ORIGIN=http://localhost:3000
# true only when deployed behind a proxy that sets X-Forwarded-For (Railway/Fly).
TRUST_PROXY=false

# ── Website (set these in the web host, e.g. Vercel) ─────
# Where the website forwards /v1/* calls. Defaults to http://localhost:8787.
API_URL=http://localhost:8787
NEXT_PUBLIC_CCD_NETWORK=testnet

# ── Concordium network ───────────────────────────────────
CCD_NETWORK=testnet
CCD_GRPC_HOST=grpc.testnet.concordium.com
CCD_GRPC_PORT=20000

# ── Concordium accounts (public addresses, safe to share) ─
# Swap these to move between identities (e.g. personal test ID → company ID).
CCD_COMPANY_ADDRESS=
CCD_AGENT_ADDRESS=
CCD_SPONSOR_ADDRESS=
CACHET_TREASURY_ADDRESS=
# Person who pays bills in the demo. Must stay at 0 CCD.
CCD_PERSON_ADDRESS=
# Facilitator settles x402 payments; can be the same account as the sponsor.
CCD_FACILITATOR_ADDRESS=

# ── Concordium keys (secret) ─────────────────────────────
# Paths to wallet key exports, stored OUTSIDE this repo (e.g. C:/Users/<you>/cachet-keys/sponsor.export)
CCD_SPONSOR_KEY_PATH=
CCD_AGENT_KEY_PATH=
CCD_FACILITATOR_KEY_PATH=

# ── Digital euro (Protocol-Level Token) ──────────────────
# Testnet: EUDemo (request at https://allowlist.testnet.concordium.com/; every account that
# holds it must be on its allow list). `pnpm find-tokens` lists all tokens.
PLT_TOKEN_ID=EUDemo
PLT_DECIMALS=6

# ── x402 (pay-per-seal) ──────────────────────────────────
# Concordium's hosted testnet facilitator (API key from Concordium, 20 Nov). (secret) key.
# local  = Cachet's own facilitator (@x402/concordium, the sponsor account pays the fees)
# hosted = Concordium's hosted testnet facilitator (needs URL + API key; `pnpm x402:check`)
X402_FACILITATOR=local
X402_FACILITATOR_URL=
X402_FACILITATOR_API_KEY=
# x-api-key for Concordium's facilitator (`pnpm x402:check` tells you)
X402_FACILITATOR_AUTH=x-api-key
# Price of one sealed call in the payment token (EUDemo on testnet)
SEAL_PRICE=0.01
# Telegram Mini App: public https address of the website (a tunnel when testing locally)
MINIAPP_URL=

# ── Agent Registry ───────────────────────────────────────
AGENT_REGISTRY_API=https://agent-registry-mcp.concordium.com
AGENT_REGISTRY_INDEXER=https://agent-registry-indexer.concordium.com
# (secret) GitHub token with ONLY the "gist" scope: temporary public hosting for Agent Cards
# until Cachet has its own domain. Never a token with repo access.
GIST_TOKEN=
# Testnet values confirmed via contract_info on 17 Nov 2026
CIS8004_CONTRACT=<12802,0>
CIS8_CONTRACT=<12801,0>

# ── Verify & Access (Concordium Credential Verification Service, runs in Docker) ──
VERIFIER_URL=http://localhost:8000
VERIFIER_HEALTH_URL=http://localhost:8001/health
# Key export of the account that pays the verifier's on-chain anchors (~0.02 EUR in CCD each).
# Use a DEDICATED account (not the sponsor) so their transaction counters never clash. Outside the repo.
CCD_VERIFIER_ADDRESS=
CCD_VERIFIER_KEY_PATH=
# Identity providers trusted for COMPANY identities. Testnet: 4 = Global FinReg Testnet.
COMPANY_ID_ISSUERS=4

# ── Data ─────────────────────────────────────────────────
# Matches infra/docker-compose.yml for local dev. Use Neon / Upstash URLs in production.
DATABASE_URL=postgres://cachet:cachet@localhost:5432/cachet
REDIS_URL=redis://localhost:6379

# ── Telegram (secret) ────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ── Cachet secrets (secret; generated by a script later) ─
SEAL_SIGNING_KEY=
PHONE_PEPPER=
CALL_CODE_SECRET=
PHONE_ENC_KEY=
SESSION_SECRET=

# ── Wallet connection (Reown / WalletConnect) ────────────
WALLETCONNECT_PROJECT_ID=

# ── Voice provider (decided in Phase 4) ──────────────────
VOICE_PROVIDER=
VOICE_API_KEY=

# ── Lamp (optional extra) ────────────────────────────────
MQTT_URL=
MQTT_USER=
MQTT_PASS=

# ── Monitoring ───────────────────────────────────────────
SENTRY_DSN=
