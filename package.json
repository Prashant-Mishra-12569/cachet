{
  "name": "cachet",
  "version": "0.0.0",
  "private": true,
  "description": "Cachet: the seal on every AI call.",
  "author": "Prashant Mishra",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev-ports.mjs check && turbo run dev --env-mode=loose",
    "dev:stop": "node scripts/dev-ports.mjs stop",
    "db:copy": "node scripts/db-copy.mjs",
    "deploy:env": "node scripts/deploy-env.mjs",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "test": "turbo run test",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "db:up": "docker compose --env-file .env -f infra/docker-compose.yml up -d",
    "db:down": "docker compose --env-file .env -f infra/docker-compose.yml down",
    "find-tokens": "pnpm --filter @cachet/scripts find-tokens",
    "smoke:grpc": "pnpm --filter @cachet/scripts smoke:grpc",
    "registry:check": "pnpm --filter @cachet/scripts registry:check",
    "check-keys": "pnpm --filter @cachet/scripts check-keys",
    "auth:smoke": "pnpm --filter @cachet/scripts auth:smoke",
    "proof:smoke": "pnpm --filter @cachet/scripts proof:smoke",
    "gen-secrets": "pnpm --filter @cachet/scripts gen-secrets",
    "seal:smoke": "pnpm --filter @cachet/scripts seal:smoke",
    "anchor:verify": "pnpm --filter @cachet/scripts anchor:verify",
    "delivery:bench": "pnpm --filter @cachet/scripts delivery:bench",
    "bot:copy": "pnpm --filter @cachet/server copy:preview",
    "credits:buy": "pnpm --filter @cachet/scripts credits:buy",
    "x402:check": "pnpm --filter @cachet/scripts x402:check",
    "voice:setup": "pnpm --filter @cachet/scripts voice:setup",
    "voice:test": "pnpm --filter @cachet/scripts voice:test",
    "call": "pnpm --filter @cachet/scripts call",
    "w3id": "pnpm --filter @cachet/scripts w3id",
    "mcp": "pnpm -s --filter @cachet/mcp start",
    "mcp:example": "pnpm --filter @cachet/mcp example"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "turbo": "2.11.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0"
  }
}
