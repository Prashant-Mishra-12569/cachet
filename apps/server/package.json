{
  "name": "@cachet/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cachet server: API, Telegram bot, x402 facilitator and background worker in one Node process.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "company:status": "tsx src/cli/company-status.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "copy:preview": "tsx src/bot/copy-preview.ts"
  },
  "dependencies": {
    "@cachet/concordium": "workspace:*",
    "@cachet/db": "workspace:*",
    "@cachet/shared": "workspace:*",
    "@concordium/web-sdk": "12.0.2",
    "@grammyjs/auto-retry": "2.0.2",
    "@hono/node-server": "2.1.9",
    "@x402/concordium": "2.32.0",
    "@x402/core": "2.32.0",
    "@x402/hono": "2.32.0",
    "grammy": "1.46.0",
    "hono": "4.13.19",
    "redis": "6.3.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  }
}
